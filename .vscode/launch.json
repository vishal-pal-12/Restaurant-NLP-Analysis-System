{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "▶️ Launch Streamlit App",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "${workspaceFolder}/app.py"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "🧪 Run All Tests (test_pipeline.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/test_pipeline.py",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "⚙️ Train All Models (train_models.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/train_models.py",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
